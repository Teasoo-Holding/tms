# Copy to .env for local development. Production values come from the managed secrets service.
# With Neon: `neon deploy` writes DATABASE_URL, DATABASE_URL_UNPOOLED and AWS_* (object storage) to the
# repo-root .env.local, which is loaded automatically; only set below what you need to override.
PORT=3000
DATABASE_URL=postgres://tms:tms@localhost:5432/tms
JWT_ACCESS_SECRET=change-me-access
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90
# Offline access window: how long a device may keep working without revalidating the session.
OFFLINE_SESSION_DAYS=30
# Media storage driver: "local" (development only) or "s3" (any S3-compatible managed store)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./var/media
LOCAL_STORAGE_SIGNING_SECRET=change-me-media
# Base URL in dev signed media links; use the web origin (http://localhost:5173) so the portal can show photos.
PUBLIC_BASE_URL=http://localhost:3000
S3_BUCKET=tms-media
S3_REGION=us-east-1
S3_ENDPOINT=
# Endpoint written into presigned URLs when devices reach storage by a different address (e.g. local MinIO).
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MEDIA_MAX_BYTES=15728640
UPLOAD_URL_TTL_SECONDS=600
CORS_ORIGINS=http://localhost:5173

      "reason": "serial not last",
      "scheme": {
        "separator": "-",
        "serialWidth": 6,
        "components": [
          {
            "type": "SERIAL",
            "required": true
          },
          {
            "type": "PROJECT_CODE",
            "required": true
          }
        ],
        "serialUniquenessScope": []
      }
    },
    {

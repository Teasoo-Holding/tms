      "scheme": {
        "separator": "-",
        "serialWidth": 6,
        "components": [
          {
            "type": "PROJECT_CODE",
            "required": true
          }
        ],
        "serialUniquenessScope": []
      }
    },
    {
      "reason": "duplicate component",
      "scheme": {
        "separator": "-",
        "serialWidth": 6,
        "components": [
          {
            "type": "PROJECT_CODE",
            "required": true
          },
          {
            "type": "PROJECT_CODE",
            "required": true
          },
          {
            "type": "SERIAL",
            "required": true
          }
        ],
        "serialUniquenessScope": []
